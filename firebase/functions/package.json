{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@langchain/anthropic": "^0.1.1",
    "@langchain/core": "^0.3.19",
    "@langchain/google-genai": "^0.0.8",
    "@langchain/langgraph": "^0.2.23",
    "@langchain/openai": "^0.3.14",
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "axios": "1.13.5",
    "braintree": "^3.6.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^5.1.0",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "qs": "^6.7.0",
    "razorpay": "^2.8.4",
    "stripe": "^8.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "serve": "firebase -P msmcrm-g24k37 emulators:start --only functions",
    "shell": "firebase -P msmcrm-g24k37 functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P msmcrm-g24k37 functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}

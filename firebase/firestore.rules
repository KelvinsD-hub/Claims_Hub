rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    // Fields a claimant (secure_token link, unauthenticated) is allowed to
    // write through the public evidence / terms / LOA forms. Anything not in
    // this list (email triggers, solicitor fields, server-generated URLs,
    // lead_ref, createdAt, secure_token, client_email) is staff/server-only.
    function claimantWritableFields() {
      return [
        'pnr_number', 'bvn_number', 'NIN', 'Passport', 'airline_response',
        'claim_status', 'flight_details_submitted', 'terms_accepted',
        'signature_submitted', 'bank_name', 'account_no', 'account_name',
        'signed_at', 'departure', 'destination', 'full_name',
        'duration_of_delay', 'flight_date', 'claims_amount', 'airline_name',
        'flight_number', 'claims_reason', 'attached_document', 'signature'
      ];
    }

    // ── Role model ─────────────────────────────────────────────────────────
    // Signing in is not enough: anyone can create an account. Access to client
    // data turns on the caller's own users/{uid} document, which only an admin
    // can approve or assign a role on (see the users rules below).
    //
    //   approved == true          staff: may read and work leads and claims
    //   role 'Agent'              default staff role
    //   role 'Solicitor'          in-house lawyers; staff access plus the
    //                             solicitor exports
    //   role 'Manager'            staff access plus deleting records
    //   role 'Admin'              manages staff accounts and roles
    //   role 'Super Admin'        as Admin, and the only role that can create
    //                             or change another Super Admin
    //
    // The { admin: true } custom claim (firebase/scripts/set-admin.js) is kept
    // as a break-glass route in: it works even if every users document is wrong.
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasAdminClaim() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function isStaff() {
      return signedIn() && (hasAdminClaim() || me().get('approved', false) == true);
    }
    function hasRole(roles) {
      return isStaff() && me().get('role', '') in roles;
    }
    function isSuperAdmin() {
      return hasAdminClaim() || hasRole(['Super Admin']);
    }
    function isAdmin() {
      return hasAdminClaim() || hasRole(['Admin', 'Super Admin']);
    }
    function isManager() {
      return hasAdminClaim() || hasRole(['Manager', 'Admin', 'Super Admin']);
    }
    function isLegal() {
      return hasAdminClaim() || hasRole(['Solicitor', 'Manager', 'Admin', 'Super Admin']);
    }

    // A claimant update may only touch the allowlisted fields, must keep the
    // token unchanged, and may only move claim_status to a claimant-settable
    // value (never to Won/Paid/etc.).
    function isValidClaimantUpdate() {
      return resource.data.secure_token is string
        && resource.data.secure_token.size() > 10
        && request.resource.data.secure_token == resource.data.secure_token
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(claimantWritableFields())
        && (
             !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['claim_status'])
             || request.resource.data.claim_status in ['Terms Pending', 'Ready For Review']
           );
    }

    // Users.
    //
    // CREATE — a person creates their own document at sign-up, and it can only
    //          start unapproved and without a role.
    // READ   — your own document (the app needs it to show "waiting for
    //          approval"), or any staff member.
    // UPDATE — your own profile, but never your own approval or role. Admins
    //          set those; only a Super Admin may grant the Super Admin role or
    //          change someone who holds it.
    // DELETE — admin-only. Self-service account deletion still works: it goes
    //          through Firebase Auth and the onUserDeleted function cleans up
    //          the doc with the Admin SDK.
    function accessUnchanged() {
      return request.resource.data.get('approved', false) == resource.data.get('approved', false)
          && request.resource.data.get('role', '') == resource.data.get('role', '');
    }
    function touchesSuperAdmin() {
      return resource.data.get('role', '') == 'Super Admin'
          || request.resource.data.get('role', '') == 'Super Admin';
    }
    match /users/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.get('approved', false) == false
                    && request.resource.data.get('role', '') == '';
      allow read:   if signedIn() && (request.auth.uid == userId || isStaff());
      allow update: if (signedIn() && request.auth.uid == userId && accessUnchanged())
                    || (isAdmin() && !touchesSuperAdmin())
                    || isSuperAdmin();
      allow delete: if isAdmin() && (resource.data.get('role', '') != 'Super Admin' || isSuperAdmin());
    }

    // Staff invitations. Created, read, used and cancelled only through the
    // staffInvite function (functions/invites.js); no client touches them.
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // Requests to a client for more information. Created, withdrawn and
    // answered only through the infoRequest and clientInfoRequest functions
    // (functions/info-requests.js); staff read them to see what was asked
    // and what came back.
    // Short links for ads and posts (claimsassistltd.com/go/<code>). Managers
    // make and switch them off on the Links page; the website's `go`
    // function counts clicks, which nobody else may write. A link is never
    // deleted, so the leads credited to it keep their name. Partner links
    // are made by the server only.
    match /campaign_links/{code} {
      allow read: if isStaff();
      allow create: if isManager()
        && code.matches('^[a-z0-9][a-z0-9-]{1,31}$')
        && request.resource.data.keys().hasOnly([
             'label', 'channel', 'destination', 'active', 'clicks',
             'created_at', 'created_by', 'created_by_name'])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80
        && request.resource.data.channel in [
             'facebook', 'instagram', 'x', 'tiktok', 'whatsapp', 'linkedin',
             'youtube', 'google', 'email', 'sms', 'other']
        && request.resource.data.destination in ['/', '/check']
        && request.resource.data.active == true
        && request.resource.data.clicks == 0
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.created_at == request.time;
      allow update: if isManager()
        && resource.data.channel != 'partner'
        && changedKeys().hasOnly(['label', 'active'])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // Referral partners: people outside the firm who bring in clients. Made,
    // suspended and signed in only through the partnerAdmin and
    // partnerPortal functions (functions/partners.js). Admins read the list;
    // partners themselves read nothing here, and see only what partnerPortal
    // hands them.
    match /partners/{partnerId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /info_requests/{requestId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ── Stages and casework ────────────────────────────────────────────────
    // A lead's or claim's stage is changed by the changeStage Cloud Function,
    // which checks the move is allowed, records who made it and opens the
    // claim when a lead is qualified. Who owns a record, its next action and
    // a claim's legal stage are changed by the caseAction function, which
    // checks who is asking and writes the event log. Staff can edit everything
    // else on a record directly, but not these fields.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function caseworkFields() {
      return [
        'handler_uid', 'handler_name', 'handler_assigned_at',
        'handler_assigned_by', 'handler_assigned_by_name',
        'next_action', 'next_action_due', 'next_action_set_by',
        'next_action_set_by_name',
        'ai_opt_out', 'ai_opt_out_at', 'ai_opt_out_by', 'ai_opt_out_by_name',
        'info_request_open', 'info_request_sent_at', 'info_request_answered_at'
      ];
    }
    function leavesLeadStageAlone() {
      return !changedKeys().hasAny([
        'status', 'is_qualified', 'claim_ref',
        'stage_changed_at', 'stage_changed_by', 'stage_changed_by_name',
        // Which link and partner a lead is credited to are set once, by the
        // website and the server.
        'source_link', 'partner_id', 'partner_name'
      ]) && !changedKeys().hasAny(caseworkFields());
    }
    function leavesClaimStageAlone() {
      return !changedKeys().hasAny([
        'claim_status', 'is_escalated', 'lead_ref', 'secure_token',
        'stage_changed_at', 'stage_changed_by', 'stage_changed_by_name',
        'source_link', 'partner_id', 'partner_name'
      ]) && !changedKeys().hasAny(caseworkFields()) && !changedKeys().hasAny([
        'lawyer_uid', 'lawyer_name', 'lawyer_assigned_at',
        'lawyer_assigned_by', 'lawyer_assigned_by_name',
        'legal_stage', 'legal_stage_changed_at', 'legal_stage_changed_by',
        'legal_stage_changed_by_name', 'escalated_at', 'closed_at',
        'amount_recovered', 'settlement_offer_amount', 'settlement_offer_at',
        'airline_reply_at', 'airline_reply_summary',
        'trigger_airline_email', 'trigger_solicitor_email',
        'airline_email_selection', 'letter_requested_by',
        'letter_requested_by_name'
      ]);
    }

    // Leads: public create supports the public-facing lead capture form and
    // the website checker. Only staff can read or change them.
    match /leads/{document} {
      allow create: if true;
      allow read:   if isStaff();
      allow update: if isStaff() && leavesLeadStageAlone();
      allow delete: if isManager();
    }

    // Watchlist: public create supports the website's Flight Watchdog signup.
    // Read/processing is staff and backend only.
    match /watchlist/{document} {
      allow create: if true;
      allow read:   if isStaff();
      allow update: if isStaff();
      allow delete: if isManager();
    }

    // Dashboard aggregates, written by Cloud Functions only.
    match /stats/{document} {
      allow read: if isStaff();
    }

    // Blog posts: managed from the website's /admin dashboard by approved
    // staff. Public pages are server-rendered by the `blog` Cloud Function
    // (Admin SDK, bypasses rules), so no public client read is needed.
    match /blog_posts/{document} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }

    // Flight stats: anonymous per-flight claim counters maintained by the
    // backend (group-claim social proof on the website). Counts only, no PII.
    // Public GET by exact doc id; no public list or write.
    match /flight_stats/{document} {
      allow get:    if true;
      allow list:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isManager();
    }

    // Claims: agents create records; claimants interact via secure_token links.
    //
    // CREATE — nobody directly: a claim is opened by the changeStage function
    //          when its lead is qualified.
    // GET    — staff, OR a capability-URL request: the caller
    //          already knows the exact document ID (delivered in the emailed
    //          claim link) and the doc carries a secure_token. This intentionally
    //          does NOT allow LIST, so the collection cannot be enumerated by an
    //          unauthenticated client.
    // LIST   — staff only (prevents mass PII enumeration).
    // UPDATE — staff may change anything except the stage. A claimant using a
    //          secure_token link may only submit their own evidence: the token
    //          must match, only allowlisted fields may change, and claim_status
    //          may only move to a claimant-settable value (see isValidClaimantUpdate).
    // DELETE — managers and above.
    //
    // NOTE: token-path writes still cannot be attributed to a specific person,
    // so bank/account fields remain claimant-writable by design. Moving the
    // claimant write path behind an authenticated Cloud Function (server-side
    // token validation) is the recommended Phase 2 hardening.
    match /claims/{document} {
      allow create: if false;
      allow get:    if isStaff()
                    || resource.data.secure_token is string;
      allow list:   if isStaff();
      allow update: if (isStaff() && leavesClaimStageAlone())
                    || isValidClaimantUpdate();
      allow delete: if isManager();
    }

    // Solicitor exports: the legal team and managers.
    match /solicitor_exports/{document} {
      allow read, create, update: if isLegal();
      allow delete: if isManager();
    }

    // Activity logs: an audit trail. Staff add entries and read them; nobody
    // edits or removes one.
    match /activity_logs/{document} {
      allow create: if isStaff();
      allow read:   if isStaff();
    }

    // AI assistant answers: written by the aiAssist function only, so what
    // the assistant said, who asked and what staff made of it cannot be
    // edited afterwards. Staff read them.
    match /ai_outputs/{document} {
      allow read: if isStaff();
    }

    // Airlines directory: internal staff only — no public exposure needed.
    match /airlines_directory/{document} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff are accounts an admin has approved — the same test the Firestore
    // rules apply. Signing in alone is not enough: anyone can create an account.
    function isStaff() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
                 .data.get('approved', false) == true);
    }

    // Default: deny everything not explicitly matched below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User profile assets (photos, etc.) — owner write, authenticated read.
    match /users/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A claim's documents: the letters the system generates and the evidence
    // the client sends. Staff only.
    match /claims/{claimId}/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Client evidence (boarding passes, ID scans). A client reaches the
    // evidence form through an emailed link and is not signed in, so adding a
    // file here is open — but only adding: an image or PDF under 8 MB, in this
    // folder, under a name not already taken. A client cannot read a file
    // back, replace one, or touch the generated letters beside this folder.
    // 8 MB keeps every upload within what staffDocument can serve.
    match /claims/{claimId}/evidence/{fileName} {
      allow create: if resource == null
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType != null
                    && (
                         request.resource.contentType.matches('image/.*')
                         || request.resource.contentType == 'application/pdf'
                       );
    }

    // Solicitor export files — internal staff only.
    match /solicitor_exports/{allPaths=**} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }
  }
}
